    "@capacitor/push-notifications": "^8.1.3",
    "@supabase/supabase-js": "^2.117.2",
    "@types/leaflet": "^1.9.22",
    "animejs": "^4.5.0",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.51.0",
    "motion": "^14.9.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "webflow": "^0.0.1-security.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
