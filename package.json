{
  "name": "imc-311-portal",
  "version": "1.1.2",
  "private": true,
  "description": "A modern, component-based civic portal inspired by the Indore 311 platform for municipal corporations (IMC / Betul Municipal Council). Citizens can report civic issues with auto-detected GPS location and photos, track resolution status in real time, and verify fixes before complaints are officially closed.",
  "homepage": "https://github.com/printingtaskweb-dot/betul-48#readme",
